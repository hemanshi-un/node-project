<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
        }
        h1 {
            color: red;
        }
    </style>
</head>
<body>
    <h1>Profile Page</h1>

    <p>Name: <%= user.name %></p>
    <p>Age: <%= user.age %></p>
    <p>City: <%= user.city %></p>
    <p>Skills: <%= user.skills.join(', ') %></p>
</body>
</html>